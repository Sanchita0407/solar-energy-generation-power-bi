	column Hour = ```
			HOUR(SolarData[DATE_TIME])
			
			```
		formatString: 0
		lineageTag: 0b89e2f6-7868-4157-b59c-7a3ec1578ff4
		summarizeBy: sum

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column Date = ```
			
			DATE(
			    YEAR(SolarData[DATE_TIME]),
			    MONTH(SolarData[DATE_TIME]),
			    DAY(SolarData[DATE_TIME])
			)
			
			```
		formatString: General Date
		lineageTag: c9fab36b-3b2b-455e-abc1-6807b40c4603
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 4f709464-a3fd-4aa9-8346-52e8b4da533a
			defaultHierarchy: LocalDateTable_410b096e-a56a-432a-a076-335b42b2bb5f.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column 'Week Start' = ```
			
			SolarData[Date] - WEEKDAY(SolarData[Date], 2) + 1
			
			```
		formatString: General Date
		lineageTag: f65e8f4f-8ad9-4e59-aa55-3e3232e3d6b5
		summarizeBy: none

		variation Variation
