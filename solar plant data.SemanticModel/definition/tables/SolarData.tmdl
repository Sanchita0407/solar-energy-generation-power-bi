table SolarData
	lineageTag: 7c5c2dca-cbbf-4082-a631-4d9a21bfb4a9

	measure 'Total Plants' =
			
			DISTINCTCOUNT(SolarData[PLANT_ID])
		formatString: 0
		lineageTag: 6c40c20d-380d-484f-aaba-821414dc385c

	measure 'Average AC Power' =
			
			AVERAGE(SolarData[AC_POWER])
		lineageTag: 4aef408a-a75c-4963-ad15-507ba5fe7336

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Daily Yield' =
			
			AVERAGE(SolarData[DAILY_YIELD])
		lineageTag: 286335af-d7e5-48e8-8c67-210ceafbe621

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Selected AC Power' = ```
			
			IF(
			    HASONEVALUE(SolarData[DATE_TIME]),
			    AVERAGE(SolarData[AC_POWER]),
			    BLANK()
			)
			
			```
		lineageTag: aa364610-849f-4aa0-af28-80e0dbce4e36

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Selected Daily Yield' = ```
			
			IF(
			    HASONEVALUE(SolarData[Date]),
			    AVERAGE(SolarData[DAILY_YIELD]),
			    BLANK()
			)
			
			```
		lineageTag: 79b76d6a-0638-4054-8b6a-02b4469e62d6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Weekly Selected Yield' = ```
			
			IF(
			    HASONEVALUE(SolarData[Week Start]),
			    AVERAGE(SolarData[DAILY_YIELD]),
			    BLANK()
			)
			
			```
		lineageTag: 36f31804-7e40-4a75-bc26-d9607056f8b0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Monthly Selected Yield' =
			
			IF(
			    HASONEVALUE(SolarData[Date]),
			    AVERAGE(SolarData[DAILY_YIELD]),
			    BLANK()
			)
		lineageTag: d3e72243-c926-4a41-ad07-45ba7c89ab27

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Hourly Selected Yield' =
			
			IF(
			    HASONEVALUE(SolarData[Hour]),
			    AVERAGE(SolarData[DAILY_YIELD]),
			    BLANK()
			)
		lineageTag: b85753c7-d95a-44d7-aa3a-7d0407a26f61

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'AC to DC Power Ratio (%)' = ```
			
			DIVIDE(
			    SUM(SolarData[AC_POWER]),
			    SUM(SolarData[DC_POWER]),
			    0
			) * 100
			
			```
		lineageTag: 0408b104-72e3-46a0-9570-60d21e345cdd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Missing Date Records' =
			
			COUNTROWS(
			    FILTER(
			        SolarData,
			        ISBLANK(SolarData[DATE_TIME])
			    )
			)
		formatString: 0
		lineageTag: 436b8416-e052-4e09-b1c4-4cc8f71ce198

	measure 'Duplicate Records' =
			
			COUNTROWS(SolarData) -
			COUNTROWS(
			    DISTINCT(SolarData)
			)
		formatString: 0
		lineageTag: 0a8a2bf5-efaf-432d-ba5c-61b02e237cc0

	measure 'Zero DC Power Records' =
			
			COUNTROWS(
			    FILTER(
			        SolarData,
			        SolarData[DC_POWER] = 0
			    )
			)
		formatString: 0
		lineageTag: 949e6ed5-fade-4ead-b1cd-49774ad71bbe

